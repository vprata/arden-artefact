{% extends "base.html" %}{% block title %}{{ 'Edit' if collection else 'New' }} Collection – Custom Collectibles{% endblock %}{% block content %}<div class="row justify-content-center">    <div class="col-md-6">        <div class="card shadow">            <div class="card-body p-4">                <h2 class="mb-4">{{ 'Edit' if collection else 'New' }} Collection</h2>                <form method="POST">                    <div class="mb-3">                        <label class="form-label">Name *</label>                        <input type="text" name="name" class="form-control" required                               value="{{ collection.name if collection else '' }}">                    </div>                    <div class="mb-3">                        <label class="form-label">Description</label>                        <textarea name="description" class="form-control" rows="3">{{ collection.description if collection else '' }}</textarea>                    </div>                    <div class="mb-3">                        <label class="form-label">Category</label>                        <select name="category_id" class="form-select">                            <option value="">— None —</option>                            {% for cat in categories %}                            <option value="{{ cat._id }}"                                {% if collection and collection.category_id == cat._id %}selected{% endif %}>                                {{ cat.name }}                            </option>                            {% endfor %}                        </select>                    </div>                    <div class="form-check mb-3">                        <input class="form-check-input" type="checkbox" name="is_public" id="is_public"                               {% if collection and collection.is_public %}checked{% endif %}>                        <label class="form-check-label" for="is_public">                            Make this collection public (visible to everyone)                        </label>                    </div>                    <button type="submit" class="btn btn-primary">Save Collection</button>                    {% if collection %}                    <a href="{{ url_for('collections.view_collection', collection_id=collection._id) }}"                       class="btn btn-outline-secondary">Cancel</a>                    {% else %}                    <a href="{{ url_for('main.dashboard') }}" class="btn btn-outline-secondary">Cancel</a>                    {% endif %}                </form>            </div>        </div>        {% if collection %}        <div class="card shadow mt-4 border-danger">            <div class="card-body p-4">                <h5 class="text-danger">Delete collection</h5>                <p class="text-muted small mb-3">                    This will permanently delete <strong>{{ collection.name }}</strong>                    and all items and uploaded images inside it. This cannot be undone.                </p>                <form method="POST"                      action="{{ url_for('collections.delete_collection', collection_id=collection._id) }}"                      onsubmit="return confirm('Delete collection “{{ collection.name }}” and all of its items and images? This cannot be undone.');">                    <button type="submit" class="btn btn-danger">Delete Collection</button>                </form>            </div>        </div>        {% endif %}    </div></div>{% endblock %}
